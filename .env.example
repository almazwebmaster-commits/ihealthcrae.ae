# Copy to .env and fill in — or run `neon env pull` to write these automatically.
# Pooled connection (hostname contains -pooler): used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Direct connection: used by Prisma migrate and Studio.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
NEON_BRANCH=production

# Better Auth — session signing secret (keep private; rotate = everyone signed out)
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
# Extra origins allowed to sign in (LAN testing from iPad/phone)
BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.8.7:3000,http://172.16.31.113:3000"

# Google sign-in (leave empty to hide the button) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Outgoing mail via your own mailbox (SMTP). Empty SMTP_HOST = emails are saved to .mail-outbox/
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="iHealthcare <no-reply@ihealthcare.ae>"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CRON_SECRET="random-string"
